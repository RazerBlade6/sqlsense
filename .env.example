AWS_REGION=ap-southeast-2
SQL_MODEL_ID=apac.amazon.nova-pro-v1:0
PLANNER_MODEL_ID=apac.amazon.nova-micro-v1:0
# Once Claude access is enabled:
# SQL_MODEL_ID=au.anthropic.claude-sonnet-5-5
# PLANNER_MODEL_ID=au.anthropic.claude-haiku-5-5
DATABASE_URL=postgresql+psycopg://readonly_user:password@localhost:5432/appdb
DB_INCLUDE_SCHEMAS=public
MAX_RESULT_ROWS=100
SQL_STATEMENT_TIMEOUT_MS=8000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
