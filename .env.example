AWS_REGION=ap-southeast-2
SQL_MODEL_ID=apac.amazon.nova-pro-v1:0
PLANNER_MODEL_ID=apac.amazon.nova-micro-v1:0
SYNTHESIZER_MODEL_ID=apac.amazon.nova-pro-v1:0
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# Once Claude access is enabled:
# SQL_MODEL_ID=au.anthropic.claude-sonnet-5-5
# PLANNER_MODEL_ID=au.anthropic.claude-haiku-5-5
# SYNTHESIZER_MODEL_ID=au.anthropic.claude-sonnet-5-5
WAREHOUSE=duckdb
ATHENA_WORKGROUP=sqlsense
GLUE_DATABASE=retail
RETRIEVAL_STORE=local
MEMORY_STORE=local
DAILY_QUESTION_LIMIT=0
MAX_RESULT_ROWS=100
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
